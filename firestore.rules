rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /calls/{callId} {
      allow read, create, update: if signedIn();

      match /{candidateCollection}/{candidateId} {
        allow read, create: if signedIn();
      }
    }

    match /rooms/{roomId} {
      allow read, create, update: if signedIn();

      match /{candidateCollection}/{candidateId} {
        allow read, create: if signedIn();
      }
    }

    match /team_meet_conversations/{conversationId} {
      allow read, create, update: if signedIn();
    }
  }
}